# ~/haven/.env — settings for a self-hosted Haven Hub.  chmod 600 ~/haven/.env   (never commit this file)

# The address people open (your domain, through Cloudflare Tunnel). Personal links and the Telegram webhook use it.
PUBLIC_URL=https://haventashkent.xyz
# Where the app listens (local only — cloudflared forwards to it)
PORT=8787
HOST=127.0.0.1
HUB_TZ=Asia/Tashkent
OWNER_EMAIL=you@example.com

# Cloudflare Tunnel token (Cloudflare → Zero Trust → Networks → Tunnels → your tunnel → install → the long token)
CF_TUNNEL_TOKEN=
# No domain yet? QUICK_TUNNEL=1 gives a temporary https://….trycloudflare.com address (changes on restart — testing only)
QUICK_TUNNEL=

# Email (Gmail with an App Password: myaccount.google.com/apppasswords — needs 2-Step Verification)
SMTP_USER=you@gmail.com
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_DAILY_LIMIT=400

# Telegram webhook secrets — leave empty, the server makes random ones and keeps them
TG_SECRET=
TG_PATH=hook
