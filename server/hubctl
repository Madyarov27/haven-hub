#!/usr/bin/env bash
# hubctl — run Haven Hub on your own server as a normal user (no sudo, no Docker).
#   hubctl start | stop | restart | status | logs [tunnel] | ensure | deploy | quick-tunnel | tunnel-start | tunnel-stop | install-cron
#   hubctl set-secret NAME          ask for a secret (hidden) and save it in ~/haven/.env — e.g. SMTP_PASS
#   hubctl cf-login | cf-tunnel DOMAIN   put the hub on your domain with a Cloudflare named tunnel (no token copying)
#   hubctl ts-install | ts-login | ts-funnel   no domain? a free permanent https://NAME.TAILNET.ts.net address (Tailscale Funnel, no root)
#   hubctl admin-links | reset-link KEY | import-code | setup-code | backup | export | set-webhook | remind | weekly-report
set -uo pipefail
H="${HAVEN_HOME:-$HOME/haven}"
NODE="$H/node/bin/node"; APP="$H/app"; RUN="$H/run"; LOGS="$H/logs"; CF="$H/bin/cloudflared"
TS="$H/bin/tailscale"; TSD="$H/bin/tailscaled"; TSSOCK="$RUN/tailscaled.sock"
mkdir -p "$RUN" "$LOGS" "$H/data" "$H/backups"; chmod 700 "$H"
[ -f "$H/.env" ] && { set -a; . "$H/.env"; set +a; }
PORT="${PORT:-8787}"

alive() { [ -f "$RUN/$1.pid" ] && kill -0 "$(cat "$RUN/$1.pid")" 2>/dev/null; }
rotate() { for f in "$LOGS"/*.log; do [ -f "$f" ] && [ "$(stat -c %s "$f")" -gt 10485760 ] && mv -f "$f" "$f.1"; done; true; }

start_app() {
  alive app && return 0
  ( cd "$APP" && exec setsid "$NODE" --disable-warning=ExperimentalWarning "$APP/server/index.mjs" </dev/null >>"$LOGS/app.log" 2>&1 ) &
  echo $! >"$RUN/app.pid"
  sleep 1; alive app && echo "app started (pid $(cat "$RUN/app.pid"))" || { echo "app failed to start — hubctl logs"; return 1; }
}
start_tunnel() {
  alive tunnel && return 0
  if [ -n "${CF_TUNNEL_CONFIG:-}" ] && [ -f "$CF_TUNNEL_CONFIG" ]; then
    ( exec setsid "$CF" tunnel --no-autoupdate --config "$CF_TUNNEL_CONFIG" run </dev/null >>"$LOGS/tunnel.log" 2>&1 ) &
    echo $! >"$RUN/tunnel.pid"
    echo "tunnel started ($CF_TUNNEL_CONFIG)"
  elif [ -n "${CF_TUNNEL_TOKEN:-}" ]; then
    # the token goes in through the environment, never on the command line (other users can see command lines)
    ( export TUNNEL_TOKEN="$CF_TUNNEL_TOKEN"; exec setsid "$CF" tunnel --no-autoupdate run </dev/null >>"$LOGS/tunnel.log" 2>&1 ) &
    echo $! >"$RUN/tunnel.pid"
    echo "tunnel started"
  elif [ "${QUICK_TUNNEL:-}" = "1" ]; then quick_tunnel; fi
}
# Tailscale in user-space mode: no root, no network changes on the server — it only serves the hub's port over Funnel
ts() { "$TS" --socket="$TSSOCK" "$@"; }
start_ts() {
  [ "${TAILSCALE:-}" = "1" ] && [ -x "$TSD" ] || return 0
  alive tailscaled && return 0
  mkdir -p "$H/data/tailscale"
  ( exec setsid "$TSD" --tun=userspace-networking --socket="$TSSOCK" --statedir="$H/data/tailscale" --port=0 </dev/null >>"$LOGS/tailscaled.log" 2>&1 ) &
  echo $! >"$RUN/tailscaled.pid"; sleep 2
  alive tailscaled && echo "tailscale started" || echo "tailscale failed to start — hubctl logs tailscaled"
}
quick_tunnel() {
  alive tunnel && { echo "tunnel already running: $(cat "$RUN/public_url" 2>/dev/null)"; return 0; }
  : >"$LOGS/tunnel.log"
  ( exec setsid "$CF" tunnel --no-autoupdate --url "http://127.0.0.1:$PORT" </dev/null >>"$LOGS/tunnel.log" 2>&1 ) &
  echo $! >"$RUN/tunnel.pid"
  for i in $(seq 1 30); do
    u=$(grep -o 'https://[a-z0-9-]*\.trycloudflare\.com' "$LOGS/tunnel.log" | head -1)
    [ -n "$u" ] && { echo "$u" >"$RUN/public_url"; echo "temporary address: $u  (test only — it changes on every restart)"; return 0; }
    sleep 1
  done
  echo "quick tunnel did not report an address — hubctl logs tunnel"
}
# write KEY=VALUE into ~/haven/.env (keeps it private: 600)
set_env() { local tmp; tmp=$(mktemp "$H/.env.XXXXXX"); { grep -v "^$1=" "$H/.env" 2>/dev/null || true; printf '%s=%s\n' "$1" "$2"; } >"$tmp"; chmod 600 "$tmp"; mv -f "$tmp" "$H/.env"; }
# stop by pid file, and also by exact command path (in case a pid file went stale) — only this user's processes
pat() { case "$1" in app) echo "$APP/server/index.mjs" ;; tailscaled) echo "$TSD --tun" ;; *) echo "$CF tunnel" ;; esac; }
stop_one() {
  alive "$1" && kill "$(cat "$RUN/$1.pid")" 2>/dev/null
  pkill -u "$(id -u)" -f "$(pat "$1")" 2>/dev/null; sleep 1
  pkill -9 -u "$(id -u)" -f "$(pat "$1")" 2>/dev/null; rm -f "$RUN/$1.pid"; true
}

case "${1:-status}" in
  start)   start_app; start_tunnel; start_ts ;;
  stop)    stop_one tunnel; stop_one tailscaled; stop_one app; echo stopped ;;
  restart) stop_one app; start_app ;;
  ensure)  rotate; alive app || { echo "$(date -Is) ensure: app was down, starting" >>"$LOGS/app.log"; start_app; }
           { [ -n "${CF_TUNNEL_CONFIG:-}" ] || [ -n "${CF_TUNNEL_TOKEN:-}" ] || [ "${QUICK_TUNNEL:-}" = "1" ]; } && ! alive tunnel && start_tunnel
           [ "${TAILSCALE:-}" = "1" ] && ! alive tailscaled && start_ts; true ;;
  status)  for p in app tunnel tailscaled; do alive $p && echo "$p: running (pid $(cat "$RUN/$p.pid"))" || echo "$p: stopped"; done
           curl -s -m 5 "http://127.0.0.1:$PORT/healthz" && echo; alive app && "$NODE" "$APP/server/cli.mjs" status ;;
  logs)    tail -n 80 -f "$LOGS/${2:-app}.log" ;;
  quick-tunnel) quick_tunnel ;;
  tunnel-start) start_tunnel ;;
  tunnel-stop) stop_one tunnel; rm -f "$RUN/public_url"; echo "tunnel stopped" ;;
  deploy)  git -C "$APP" pull --ff-only && ( cd "$APP" && PATH="$H/node/bin:$PATH" npm ci --omit=dev --no-audit --no-fund --loglevel=error ) && stop_one app && start_app ;;
  set-secret)
    k="${2:-}"; [[ "$k" =~ ^[A-Z0-9_]+$ ]] || { echo "usage: hubctl set-secret NAME   (e.g. SMTP_PASS)"; exit 1; }
    read -r -s -p "Paste $k and press Enter (nothing is shown): " v; echo
    v="${v//[[:space:]]/}"   # Gmail shows app passwords in groups of 4 — spaces don't matter
    [ -n "$v" ] || { echo "nothing saved"; exit 1; }
    [[ "$v" =~ ^[A-Za-z0-9._~:/@+=-]+$ ]] || { echo "that has unusual characters — nothing saved"; exit 1; }
    set_env "$k" "$v"; unset v
    echo "$k saved in $H/.env"; stop_one app; start_app ;;
  cf-login)
    # prints a Cloudflare link; open it while signed in to Cloudflare, pick your domain, press Authorize
    [ -f "$HOME/.cloudflared/cert.pem" ] && { echo "already logged in to Cloudflare ($HOME/.cloudflared/cert.pem)"; exit 0; }
    "$CF" tunnel login ;;
  cf-tunnel)
    d="${2:-}"; [[ "$d" =~ ^[a-z0-9.-]+\.[a-z]{2,}$ ]] || { echo "usage: hubctl cf-tunnel yourdomain.xyz"; exit 1; }
    [ -f "$HOME/.cloudflared/cert.pem" ] || { echo "run: hubctl cf-login  first"; exit 1; }
    name="haven-hub"
    id=$("$CF" tunnel list -o json 2>/dev/null | "$NODE" -e 'let s="";process.stdin.on("data",c=>s+=c).on("end",()=>{const t=(JSON.parse(s||"[]")||[]).find(x=>x.name===process.argv[1]&&!x.deleted_at);console.log(t?t.id:"")})' "$name")
    [ -n "$id" ] || { "$CF" tunnel create "$name" >/dev/null && id=$("$CF" tunnel list -o json | "$NODE" -e 'let s="";process.stdin.on("data",c=>s+=c).on("end",()=>{const t=JSON.parse(s).find(x=>x.name===process.argv[1]&&!x.deleted_at);console.log(t?t.id:"")})' "$name"); }
    [ -n "$id" ] || { echo "could not create the tunnel"; exit 1; }
    cat >"$H/cloudflared.yml" <<YML
tunnel: $id
credentials-file: $HOME/.cloudflared/$id.json
ingress:
  - hostname: $d
    service: http://127.0.0.1:$PORT
  - hostname: www.$d
    service: http://127.0.0.1:$PORT
  - service: http_status:404
YML
    chmod 600 "$H/cloudflared.yml"
    "$CF" tunnel route dns --overwrite-dns "$name" "$d" && "$CF" tunnel route dns --overwrite-dns "$name" "www.$d"
    set_env CF_TUNNEL_CONFIG "$H/cloudflared.yml"; set_env PUBLIC_URL "https://$d"; set_env QUICK_TUNNEL ""
    stop_one tunnel; rm -f "$RUN/public_url"; stop_one app; start_app; CF_TUNNEL_CONFIG="$H/cloudflared.yml" start_tunnel
    echo "tunnel $id → https://$d (DNS can take a few minutes)" ;;
  ts-install)
    v=$(curl -fsSL "https://pkgs.tailscale.com/stable/?mode=json" | "$NODE" -e 'let s="";process.stdin.on("data",c=>s+=c).on("end",()=>console.log(JSON.parse(s).TarballsVersion))')
    [ -n "$v" ] || { echo "could not find the Tailscale version"; exit 1; }
    tmp=$(mktemp -d); curl -fsSL "https://pkgs.tailscale.com/stable/tailscale_${v}_amd64.tgz" | tar -xz -C "$tmp"
    cp "$tmp"/tailscale_*/tailscale "$tmp"/tailscale_*/tailscaled "$H/bin/" && chmod +x "$TS" "$TSD"; rm -rf "$tmp"
    "$TS" version | head -1 ;;
  ts-login)
    # prints a link: open it, sign in to Tailscale, and connect this server
    set_env TAILSCALE 1; TAILSCALE=1 start_ts
    ts status >/dev/null 2>&1 && { echo "already connected: $(ts status --json | "$NODE" -e 'let s="";process.stdin.on("data",c=>s+=c).on("end",()=>console.log(JSON.parse(s).Self.DNSName))')"; exit 0; }
    : >"$LOGS/tailscale-up.log"
    ( exec setsid "$TS" --socket="$TSSOCK" up --hostname="${TS_HOSTNAME:-haven-hub}" </dev/null >>"$LOGS/tailscale-up.log" 2>&1 ) &
    for i in $(seq 1 20); do u=$(grep -o 'https://login.tailscale.com/[^ ]*' "$LOGS/tailscale-up.log" | head -1); [ -n "$u" ] && { echo "Open this link and connect the server: $u"; exit 0; }; sleep 1; done
    echo "no login link yet — hubctl logs tailscale-up" ;;
  ts-funnel)
    # share the hub's port on https://NAME.TAILNET.ts.net (may print a link to switch Funnel on for your tailnet first)
    name=$(ts status --json | "$NODE" -e 'let s="";process.stdin.on("data",c=>s+=c).on("end",()=>console.log(String(JSON.parse(s).Self.DNSName||"").replace(/\.$/,"")))')
    [ -n "$name" ] || { echo "not connected — run: hubctl ts-login"; exit 1; }
    timeout 25 "$TS" --socket="$TSSOCK" funnel --bg "$PORT" </dev/null 2>&1 | tail -5
    ts funnel status 2>&1 | grep -q "https://$name" || { echo "Funnel is not on yet (open the link above if there is one, then run this again)"; exit 1; }
    set_env PUBLIC_URL "https://$name"; set_env QUICK_TUNNEL ""
    stop_one app; start_app
    echo "the hub is reachable at https://$name" ;;
  install-cron)
    ( crontab -l 2>/dev/null | grep -v 'haven/hubctl\|hubctl ensure\|hubctl start'
      echo "@reboot $H/hubctl start >/dev/null 2>&1"
      echo "*/2 * * * * $H/hubctl ensure >/dev/null 2>&1" ) | crontab -
    crontab -l ;;
  *)       "$NODE" --disable-warning=ExperimentalWarning "$APP/server/cli.mjs" "$@" ;;
esac
